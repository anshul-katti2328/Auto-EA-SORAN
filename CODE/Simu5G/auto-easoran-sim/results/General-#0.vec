config image-path ../../../../git/inet-4.5/images:../../../../git/Simu5G/images
config network autoeasoran.zmqonly.AutoEASORANNetwork
config sim-time-limit 10min
config description "Pure ZMQ twin: 7 gNB explicit modules, metrics PUB (5556), orchestration REP (6000), status PUB (5557)."
